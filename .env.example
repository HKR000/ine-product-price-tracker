# ==============================================================================
# INE Product Price Tracker: Environment Configuration
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development
# Allowed CORS origins in production (comma-separated, e.g. https://your-frontend.vercel.app)
CORS_ORIGIN="http://localhost:5173"

# Database Configuration (Supabase PostgreSQL)
# PRIVILEGED BACKEND ONLY: Never expose this connection string or service keys to the frontend client!
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Optional: Supabase project direct credentials
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key-here"

# Cron Job Protection Secret
# Header: X-Cron-Secret: <CRON_SECRET>
CRON_SECRET="ine_price_tracker_secret_cron_token"

# Target Mock Store Configuration
MOCK_STORE_BASE_URL="https://demo.inelabteamdev.com"

# Scraper Settings
SCRAPER_MAX_ATTEMPTS=3
SCRAPER_TIMEOUT_MS=15000
SCRAPER_HEADED=false
